# Copy to .env and adjust. Never commit the real .env file.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Leave unset to use a local SQLite file during development.
# DATABASE_URL=postgres://rnrm:password@localhost:5432/rnrm

# The website origin(s) allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Enquiry notification emails (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=rnrm Technology <no-reply@yourdomain.com>
# ENQUIRY_NOTIFY_EMAILS=you@yourdomain.com
